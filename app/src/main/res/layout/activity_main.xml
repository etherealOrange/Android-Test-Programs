<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/importSomthingButton"
        android:text="弹出对话框"
        android:id="@+id/alterDialogButton"
        android:textSize="20sp"
        />
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/importSomthingButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/alterDialogButton"
        android:text="导入文件"
        android:textSize="20sp"
        />
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/Show_fileContent_Button"
        app:layout_constraintTop_toBottomOf="@id/alterDialogButton"
        app:layout_constraintStart_toStartOf="parent"
        android:text="显示文件内容"
        android:textSize="20sp"
        />
    <com.google.android.material.button.MaterialButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/alterInputDialogButton"
        app:layout_constraintTop_toBottomOf="@+id/importSomthingButton"
        app:layout_constraintStart_toEndOf="@+id/Show_fileContent_Button"
        android:text="弹出输入框"
        android:textSize="20sp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>